# cxt-mcp container — MCP deployment (Render or Cloud Run) (multi-stage, postgres tag build).
# build (from repo root): docker build -f deploy/Dockerfile.mcp -t <registry>/cxt-mcp:<git-sha> .

FROM golang:1.26.10-alpine@sha256:27f2d3b83cfc5803c8078f8e730af0f7c431bf067afaec8f60a36fb763187cba AS build
WORKDIR /src
COPY backend/ backend/
RUN cd backend && CGO_ENABLED=0 go build -tags postgres -o /out/cxt-mcp ./cmd/cxt-mcp

FROM gcr.io/distroless/static-debian12:nonroot@sha256:b7bb25d9f7c31d2bdd1982feb4dafcaf137703c7075dbe2febb41c24212b946f
WORKDIR /app
COPY --from=build /out/cxt-mcp /app/cxt-mcp
COPY --from=build /src/backend/internal/domain/legacy_native_float64/ /usr/share/doc/cxthub/legacy-native-float64/
# Migration SQL bundled for read-only startup verification (CXT_MIGRATIONS_DIR=/app/migrations)
COPY schemas/db/migrations/ /app/migrations/
ENV CXT_MIGRATIONS_DIR=/app/migrations
ENV CXT_REQUIRE_POSTGRES=1
ENV GOMEMLIMIT=400MiB
USER nonroot:nonroot
EXPOSE 8908
# Production required env vars are injected by Render Blueprint (render.yaml): CXT_AUTH/CXT_POSTGRES_DSN/…
# Binding to 0.0.0.0 requires both verified auth and PostgreSQL; missing DSN
# fails before the HTTP listener starts (cmd/cxt-mcp/main.go).
ENTRYPOINT ["/app/cxt-mcp", "serve", "--addr", "0.0.0.0:8908"]
