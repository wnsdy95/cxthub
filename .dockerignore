# Restrict the API/MCP production build context to an explicit allowlist. This keeps local
# cxt-data, agent sessions, node_modules, Git metadata, and credentials out of the Docker
# daemon or remote builder context by construction.
**

!deploy/
!deploy/Dockerfile
!deploy/Dockerfile.mcp
!deploy/Dockerfile.migrate

!backend/
!backend/go.mod
!backend/go.sum
!backend/cmd/
!backend/cmd/**/
!backend/cmd/**/*.go
!backend/internal/
!backend/internal/**/
!backend/internal/**/*.go
!backend/internal/domain/legacy_native_float64/NOTICE.md
!backend/internal/domain/legacy_native_float64/SOURCE.json

!schemas/
!schemas/db/
!schemas/db/migrations/
!schemas/db/migrations/*.sql
