# Restrict the cxtd production build context to an explicit allowlist. This keeps local
# cxt-data, agent sessions, node_modules, Git metadata, and credentials out of the Docker
# daemon or remote builder context by construction.
**

!deploy/
!deploy/Dockerfile

!backend/
!backend/go.mod
!backend/go.sum
!backend/cmd/
!backend/cmd/**/
!backend/cmd/**/*.go
!backend/internal/
!backend/internal/**/
!backend/internal/**/*.go

!schemas/
!schemas/db/
!schemas/db/migrations/
!schemas/db/migrations/*.sql
