# Server-only examples; never copy these secrets into a frontend build.
# Copy to .env where cxtd starts. Give cxt-mcp only the shared settings below.
# Independent MCP always requires PostgreSQL; both services must use the same DB.
# CXT_POSTGRES_DSN=postgresql://user:password@host:5432/cxthub
# CXT_AUTH=firebase
# CXT_FIREBASE_PROJECT=your-project-id
# CXT_PUBLIC_URL=https://cxthub.com
# CXT_MIGRATIONS_DIR=/app/migrations
# CXT_MCP_ADDR=127.0.0.1:8908
# The remaining integration secrets belong to the API service only.
# Optional Enterprise OIDC. Generate a random base64-encoded 32-byte key and
# preserve it across API replicas/restarts. Do not share it with MCP/frontend.
# Missing key disables OIDC setup; an invalid configured key fails startup.
CXT_IDENTITY_ENCRYPTION_KEY=

# Empty key keeps invitations in the app inbox and shareable links only.
RESEND_API_KEY=

# Optional: defaults to this address. Verify its domain in Resend first.
# RESEND_FROM="CXTHub <noreply@cxthub.com>"
# Optional: public frontend origin. Defaults to CXT_PUBLIC_URL on servers,
# or http://localhost:5173 for a loopback development backend.
# CXT_WEB_URL=https://cxthub.com

# Optional GitHub App. Set all six together; partial configuration fails startup.
# GitHub sign-in is configured separately in Firebase/frontend .env.
CXT_GITHUB_APP_ID=
CXT_GITHUB_APP_CLIENT_ID=
CXT_GITHUB_APP_CLIENT_SECRET=
CXT_GITHUB_APP_PRIVATE_KEY=
CXT_GITHUB_APP_SLUG=
CXT_GITHUB_APP_WEBHOOK_SECRET=
# Callback: ${CXT_PUBLIC_URL}/api/v1/github/callback
# Setup URL: ${CXT_PUBLIC_URL}/api/v1/github/setup
# Webhook URL: ${CXT_PUBLIC_URL}/api/v1/github/webhook
# Register only read permissions: Metadata, Contents, Pull requests;
# Organization Members: read is required for organization admin proof and teams.
# Full registration/rollout guide: docs/GITHUB_CONNECTIONS.md
