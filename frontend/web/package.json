{
  "name": "@cxt/web-app",
  "private": true,
  "version": "0.1.0",
  "description": "cxt web UI — Firebase auth + workspaces + invites + team session browser (React + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:vercel": "node scripts/check-vercel-config.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "firebase": "^12.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.3",
    "vite": "^8.1.4"
  }
}
