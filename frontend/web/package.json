{
  "name": "@cxt/web-app",
  "private": true,
  "version": "0.1.0",
  "description": "cxt web UI \u2014 Firebase auth + repositories, organizations, teams + invites + team session browser (React + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node scripts/run-unit-tests.mjs",
    "test:e2e": "tsc --noEmit -p tsconfig.e2e.json && playwright test",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:vercel": "node scripts/check-vercel-config.mjs",
    "benchmark:graph": "node scripts/benchmark-graph.mjs",
    "check:architecture": "node --test scripts/check-dependencies.test.mjs && node scripts/check-dependencies.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "firebase": "^11.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "vite": "^8.3.0"
  }
}
