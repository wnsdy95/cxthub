# cxt web UI environment variables (copy to .env)

# Base URL for the cxtd REST backend.
# The default is the same-origin relative path /api/v1. Development uses the Vite proxy
# in vite.config.ts; production serves the frontend and API from the same domain.
# HttpOnly session cookies require the frontend and API to be same-site. To use an absolute URL:
# VITE_API_BASE=https://api.example.com/api/v1

# Development proxy target (backend address). Default: http://127.0.0.1:8907
# VITE_DEV_PROXY=http://127.0.0.1:8907

# Firebase configuration. Leave these values empty for development mode, which accepts an
# email address and uses a dev:<email> token compatible with a local cxtd running with auth=dev.
# Set them to enable Firebase Email/Password and Google sign-in. The macOS
# dogfood-daemon install/restart commands automatically align cxtd with this project;
# other backend launch methods need CXT_AUTH=firebase and CXT_FIREBASE_PROJECT.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
