{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit personal work handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repository_id", "state"],
  "properties": {
    "version": {"const": 1},
    "repository_id": {"$ref": "#/$defs/hash"},
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "sources"],
      "properties": {
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actor_id", "session_id", "worktree_id"],
          "properties": {
            "actor_id": {"type": "string", "minLength": 1},
            "session_id": {"type": "string", "minLength": 1},
            "worktree_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"}
          }
        },
        "goal": {"type": "string"},
        "acceptance": {"$ref": "#/$defs/notes"},
        "completed": {"$ref": "#/$defs/notes"},
        "remaining": {"$ref": "#/$defs/notes"},
        "last_verification": {"type": "string"},
        "next_step": {"type": "string"},
        "exact_user_constraints": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "source"],
            "properties": {
              "text": {"type": "string", "minLength": 1},
              "source": {"$ref": "#/$defs/source"}
            }
          }
        },
        "sources": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/source"}}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "doc_hash", "end_event", "tool"],
      "properties": {
        "snapshot_id": {"$ref": "#/$defs/hash"},
        "doc_hash": {"$ref": "#/$defs/hash"},
        "start_event": {"type": "integer", "minimum": 0, "default": 0},
        "end_event": {"type": "integer", "minimum": 1},
        "tool": {"const": "context_fetch"}
      }
    }
  }
}
