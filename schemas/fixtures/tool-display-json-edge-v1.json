{
  "version": 1,
  "oracle": {
    "runtime": "Node v22.22.3, installed locally; no network",
    "expression": "const event = JSON.parse(source); JSON.stringify(event.output, null, 2), or generic call name + newline + JSON.stringify(event.input, null, 2)",
    "renderer_source": "frontend/web/src/components/EventStream.tsx: ToolCallRow and ToolResultRow; expanded logical text, excluding UI clipping and control labels",
    "admission_sources": [
      "backend/internal/domain/cir.go: CIREvent.UnmarshalJSON (float64 interface values and map decoding)",
      "backend/internal/domain/canonical_verifier.go: CanonicalDocVerifier.eventWithKey and Verify (exact canonical byte admission)",
      "backend/internal/domain/doc_reference.go: VerifyStoredDocBytes (legacy bytes accepted under normalized content hash)",
      "backend/internal/domain/hash.go: CanonicalBytes and canonicalJSON",
      "backend/internal/domain/verified_doc.go: VerifySessionDoc and EventStreamRange (published canonical event bytes)",
      "schemas/cir.schema.json: toolCallEvent.input and toolResultEvent.output"
    ],
    "domains": {
      "canonical": "Exact event bytes pass CanonicalDocVerifier in a canonical envelope. This is implementation acceptance, not a claim of full JSON Schema validation.",
      "legacy_normalized": "Exact bytes fail canonical admission; typed decoding and VerifyStoredDocBytes accept the raw document only with its normalized content hash. VerifiedSessionDoc publishes normalized event bytes, not these originals.",
      "typed_decode_rejected": "Node parses the JSON, but typed CIREvent wire decoding rejects float64 overflow, including an overwritten number. Not accepted even by legacy normalization. This is NOT a claim that every public storage constructor rejects it."
    },
    "programmatic_number_caveat": "hash.go canonicalJSON uses UseNumber. An in-memory CIREvent with json.Number(1e400) can pass CanonicalBytes and VerifySessionDoc and retain overflow in its verified event stream, although CanonicalDocVerifier and VerifyStoredDocBytes reject those same bytes. The initial tool oracle also rejected overflow; tool-only display parity now requires JSON.stringify null, with whole-token provenance, without changing wire or storage admission. The programmatic-number admission test also covers underflow and unrounded integers. No HTTP ingress or database acceptance is inferred.",
    "stored_text": "Optional explicit expectation for display after typed storage normalization. It can differ from text: Go merges repeated struct map fields, replaces lone surrogates with U+FFFD (collapsing formerly distinct keys), and sorts ordinary keys. Local Node also checks normalized sources independently."
  },
  "provenance": {
    "coordinates": "Zero-based, half-open UTF-8 byte offsets in the original source, not JSON.stringify output or normalized storage bytes. A range query returns the min/max hull of participating source runs, even after reordering.",
    "duplicates": "Compare decoded ECMAScript UTF-16 property names. Last value wins; the first insertion fixes the ordinary-key display slot. The surviving key spelling, colon, and value are attributed to the last member occurrence, not the first or a merged object.",
    "unicode": "Escaped-equal keys collide; distinct lone surrogate code units and U+FFFD do not. A rendered normalized escape or scalar maps to the complete original escape (12 bytes for a valid surrogate pair). A displayed quoted lone surrogate is a lowercase six-byte escape, not U+FFFD.",
    "numbers": "A normalized finite number maps to its whole original numeric token. Overflow parity expectations would map rendered null to its entire overflow token; this does not expand typed CIR wire acceptance.",
    "punctuation": "Original braces, brackets, quotes, and colons retain their own anchors. Synthetic comma/newline/indent uses the byte immediately after the previous surviving value only when it is a comma; otherwise it uses the containing opening delimiter. Closing newline/indent uses the closing delimiter.",
    "range_assertions": "text selects its first display occurrence; source plus zero-based occurrence selects exact original source bytes, including duplicate tokens. Omitted occurrence means zero. These conventions specify review expectations, not a changed production contract."
  },
